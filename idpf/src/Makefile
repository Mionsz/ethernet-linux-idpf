#
# Makefile for the idpf FreeBSD VF driver skeleton.
#
# BSD make only (bsd.kmod.mk) -- no GNU Make, no CMake (spec.md S6.4,
# S9). Interface headers (device_if.h, bus_if.h, pci_if.h, ifdi_if.h)
# are generated from the kernel source tree's own .m files via
# bsd.kmod.mk's standard mechanism.
#

KMOD=		if_idpf

# Driver source files
SRCS=		if_idpf.c
SRCS+=		idpf_lib.c
SRCS+=		idpf_osdep.c
SRCS+=		idpf_txrx.c
SRCS+=		idpf_vc_common.c
SRCS+=		idpf_vc.c

# Shared code from idpf/shared/ (drivers.ethernet.shared.mev)
# Compiled directly from shared directory using .PATH
SRCS+=		idpf_common.c
SRCS+=		idpf_controlq.c
SRCS+=		idpf_controlq_setup.c
SRCS+=		idpf_controlq_fxps.c
# idpf_xn.c: ControlQ transaction manager (idpf_ctlq_xn_*), enabled by
# feature 001 (T008) now that struct idpf_sc embeds struct idpf_ctlq_xn_manager.
SRCS+=		idpf_xn.c

# Interface method headers (generated by bsd.kmod.mk)
SRCS+=		device_if.h bus_if.h pci_if.h ifdi_if.h

# Include paths: driver sources, shared code, and virtchnl headers
CFLAGS+=	-I${.CURDIR}
CFLAGS+=	-I${.CURDIR}/../shared
CFLAGS+=	-I${.CURDIR}/../shared/virtchnl

# Define FREEBSD_SUPPORT for shared code OS detection
CFLAGS+=	-DFREEBSD_SUPPORT

# Path to shared code .c files for bsd.kmod.mk
.PATH:		${.CURDIR}/../shared

# Per-file CFLAGS: Force-include idpf_type_compat.h ONLY for shared code files
# This minimal header provides type definitions without kernel includes,
# avoiding preprocessing issues. The full idpf_osdep.h is included normally
# by shared code headers that need it.
# When adding new shared code files, add a corresponding line here.
#
# Use CFLAGS.<source> (bsd.sys.mk) rather than a "target: CFLAGS +=" line: a
# target-local assignment starts from an empty value in bmake and would drop
# the -I/-D flags set above.
CFLAGS.idpf_common.c+=		-include ${.CURDIR}/idpf_type_compat.h
CFLAGS.idpf_controlq.c+=	-include ${.CURDIR}/idpf_type_compat.h
CFLAGS.idpf_controlq_setup.c+=	-include ${.CURDIR}/idpf_type_compat.h
CFLAGS.idpf_controlq_fxps.c+=	-include ${.CURDIR}/idpf_type_compat.h
CFLAGS.idpf_xn.c+=		-include ${.CURDIR}/idpf_type_compat.h
# Suppress a benign tautological compare in vendored shared idpf_xn.c (a u8
# field compared against 256); the shared file is not edited here.
CFLAGS.idpf_xn.c+=		-Wno-tautological-constant-out-of-range-compare

.include <bsd.kmod.mk>
