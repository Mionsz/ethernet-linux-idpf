#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (C) 2015-2026 Intel Corporation

set -u

usage() {
	cat <<EOF
Usage: $0 [-s] [-x|-X] [all|local|remote [node]|one core|custom|cores] interface [...]

  -s  Show current affinity settings only
  -x  Set XPS together with IRQ affinity
  -X  Disable XPS while setting IRQ affinity
EOF
}

skip() {
	echo "RESULT: SKIP - $*"
	exit 2
}

fail() {
	echo "ERROR: $*" >&2
	exit 1
}

[[ "$(uname -s)" == Linux ]] || skip "Linux only"
[[ ${EUID} -eq 0 ]] || fail "must run as root"
[[ -r /proc/interrupts && -d /sys/class/net ]] || fail "missing procfs or sysfs"

show=0
xps_mode=0
while [[ $# -gt 0 ]]; do
	case "$1" in
	-s) show=1; shift ;;
	-x) [[ $xps_mode -eq 0 ]] || fail "-x and -X cannot be combined"; xps_mode=1; shift ;;
	-X) [[ $xps_mode -eq 0 ]] || fail "-x and -X cannot be combined"; xps_mode=2; shift ;;
	-h|--help) usage; exit 0 ;;
	*) break ;;
	esac
done

[[ $# -gt 0 ]] || { usage; exit 1; }
affinity=$1
shift
remote_node=
single_core=
interfaces=()

case "$affinity" in
all|local|remote|custom) ;;
one)
	[[ $# -gt 0 && $1 =~ ^[0-9]+$ ]] || fail "one requires a CPU number"
	single_core=$1
	shift
	;;
*[!0-9,-]*|'')
	interfaces=("$affinity" "$@")
	affinity=all
	set --
	;;
*) ;;
esac

if [[ $affinity == remote && $# -gt 0 && $1 =~ ^[0-9]+$ ]]; then
	remote_node=$1
	shift
fi
if (( ${#interfaces[@]} == 0 )); then
	interfaces=("$@")
fi
(( ${#interfaces[@]} > 0 )) || fail "at least one interface is required"

for interface in "${interfaces[@]}"; do
	[[ -d /sys/class/net/$interface ]] || fail "$interface: not found"
done

expand_cores() {
	local spec=$1 item start end core
	IFS=, read -r -a items <<< "$spec"
	for item in "${items[@]}"; do
		if [[ $item =~ ^([0-9]+)-([0-9]+)$ ]]; then
			start=${BASH_REMATCH[1]}
			end=${BASH_REMATCH[2]}
			(( start <= end )) || fail "invalid CPU range: $item"
			for ((core = start; core <= end; core++)); do printf '%s\n' "$core"; done
		elif [[ $item =~ ^[0-9]+$ ]]; then
			printf '%s\n' "$item"
		else
			fail "invalid CPU list: $spec"
		fi
	done
}

mask_for_core() {
	local core=$1 word bit index part output=
	word=$((core / 32))
	bit=$((core % 32))
	for ((index = word; index >= 0; index--)); do
		if (( index == word )); then
			printf -v part '%x' "$((1 << bit))"
		else
			part=00000000
		fi
		output+="${output:+,}${part}"
	done
	printf '%s' "$output"
}

cores_for_interface() {
	local interface=$1 node node_path selected
	case "$affinity" in
	all) cat /sys/devices/system/cpu/online ;;
	one) printf '%s\n' "$single_core" ;;
	custom)
		read -r -p "CPUs for $interface (for example 0-7,15-23): " selected
		printf '%s\n' "$selected"
		;;
	local|remote)
		node_path=/sys/class/net/$interface/device/numa_node
		node=0
		[[ -r $node_path ]] && read -r node < "$node_path"
		[[ $node =~ ^[0-9]+$ ]] || node=0
		if [[ $affinity == remote ]]; then
			if [[ -n $remote_node ]]; then
				node=$remote_node
			else
				for node_path in /sys/devices/system/node/node*/cpulist; do
					[[ -r $node_path ]] || continue
					selected=${node_path%/cpulist}
					selected=${selected##*node}
					[[ $selected != "$node" ]] && { node=$selected; break; }
				done
			fi
		fi
		node_path=/sys/devices/system/node/node$node/cpulist
		[[ -r $node_path ]] || fail "$interface: no CPUs for NUMA node $node"
		cat "$node_path"
		;;
	esac
}

find_irqs() {
	local interface=$1 irq_path irq
	for irq_path in "/sys/class/net/$interface/device/msi_irqs"/*; do
		[[ -e $irq_path ]] || continue
		irq=${irq_path##*/}
		grep -q "^ *$irq:" /proc/interrupts && printf '%s\n' "$irq"
	done
}

configure_irq() {
	local interface=$1 irq=$2 core=$3 irq_dir=/proc/irq/$2 mask path
	[[ -d $irq_dir ]] || return
	if (( show )); then
		printf 'IRQ %s %s cpu=%s mask=%s hint=%s\n' "$interface" "$irq" \
			"$(cat "$irq_dir/smp_affinity_list")" \
			"$(sed 's/^0*,*//' "$irq_dir/smp_affinity")" \
			"$(sed 's/^0*,*//' "$irq_dir/affinity_hint" 2>/dev/null)"
		return
	fi
	printf '%s' "$core" > "$irq_dir/smp_affinity_list" || fail "cannot set IRQ $irq affinity"
	printf 'IRQ %s %s -> cpu %s\n' "$interface" "$irq" "$core"
	(( xps_mode != 0 )) || return
	mask=$(mask_for_core "$core")
	for path in "/sys/class/net/$interface/queues"/tx-*/xps_cpus; do
		[[ -w $path ]] || continue
		if (( xps_mode == 1 )); then
			printf '%s' "$mask" > "$path" || fail "cannot set $path"
		else
			printf '0' > "$path" || fail "cannot clear $path"
		fi
	done
}

for interface in "${interfaces[@]}"; do
	mapfile -t cores < <(expand_cores "$(cores_for_interface "$interface")")
	(( ${#cores[@]} > 0 )) || fail "$interface: no CPUs selected"
	mapfile -t irqs < <(find_irqs "$interface")
	(( ${#irqs[@]} > 0 )) || fail "$interface: no MSI-X IRQs found"
	for index in "${!irqs[@]}"; do
		configure_irq "$interface" "${irqs[index]}" "${cores[index % ${#cores[@]}]}"
	done
done

if pgrep -x irqbalance >/dev/null 2>&1; then
	echo "WARNING: irqbalance may override this configuration"
fi
echo "RESULT: PASS"